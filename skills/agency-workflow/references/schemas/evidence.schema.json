{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "evidence_id",
    "tool",
    "kind",
    "exit_code",
    "candidate",
    "outcome",
    "artifact_ref",
    "timestamp",
    "task_id",
    "target_scope",
    "operation",
    "mutates",
    "summary",
    "project_id",
    "revision",
    "updated_at",
    "acceptance_ids",
    "supersedes"
  ],
  "properties": {
    "evidence_id": {
      "type": "string",
      "minLength": 1
    },
    "tool": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "type": "string",
      "minLength": 1
    },
    "exit_code": {
      "type": [
        "integer",
        "null"
      ]
    },
    "candidate": {
      "type": "string",
      "minLength": 1
    },
    "outcome": {
      "type": "string",
      "minLength": 1,
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED",
        "UNKNOWN"
      ]
    },
    "artifact_ref": {
      "type": "string",
      "minLength": 1
    },
    "timestamp": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "const": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "target_scope": {
      "type": "string",
      "minLength": 1
    },
    "operation": {
      "type": "string",
      "minLength": 1
    },
    "mutates": {
      "type": "boolean"
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer"
    },
    "updated_at": {
      "type": "string",
      "minLength": 1
    },
    "acceptance_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "supersedes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "command"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "exit_code": {
            "type": "integer"
          }
        }
      },
      "else": {
        "properties": {
          "exit_code": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "command"
          },
          "outcome": {
            "const": "PASS"
          }
        },
        "required": [
          "kind",
          "outcome"
        ]
      },
      "then": {
        "properties": {
          "exit_code": {
            "const": 0
          }
        }
      }
    }
  ]
}

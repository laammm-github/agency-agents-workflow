{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "project_id",
    "completed",
    "unverified",
    "blocked",
    "evidence_refs",
    "next_actions",
    "candidate",
    "environment",
    "risk_refs",
    "checkpoint_ref",
    "requirement_trace",
    "revision",
    "updated_at"
  ],
  "properties": {
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "completed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "unverified": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "blocked": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "next_actions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "schema_version": {
      "const": 1
    },
    "candidate": {
      "type": "string",
      "minLength": 1
    },
    "environment": {
      "type": "string",
      "minLength": 1
    },
    "risk_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "checkpoint_ref": {
      "type": "string",
      "minLength": 1
    },
    "requirement_trace": {
      "type": "object"
    },
    "revision": {
      "type": "integer"
    },
    "updated_at": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}

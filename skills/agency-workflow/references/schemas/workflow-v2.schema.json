{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/checkpoint",
  "$defs": {
    "artifact": {
      "type": "object",
      "required": [
        "schema_version",
        "artifact_id",
        "path",
        "sha256",
        "requirement_ids",
        "task_ids",
        "version",
        "producer",
        "supersedes",
        "project_id",
        "revision",
        "updated_at",
        "category"
      ],
      "properties": {
        "artifact_id": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "requirement_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "task_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "schema_version": {
          "const": 2
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "producer": {
          "type": "string",
          "minLength": 1
        },
        "supersedes": {
          "type": [
            "string",
            "null"
          ]
        },
        "project_id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "updated_at": {
          "type": "string",
          "minLength": 1,
          "format": "date-time"
        },
        "category": {
          "enum": [
            "SOURCE",
            "CONFIG",
            "BUILD",
            "DOCUMENT",
            "EVIDENCE",
            "RUNTIME"
          ]
        }
      },
      "additionalProperties": false
    },
    "change-decision": {
      "type": "object",

            "type": "string"
          }
        },
        "updated_at": {
          "type": "string",
          "minLength": 1,
          "format": "date-time"
        },
        "state": {
          "$ref": "#/$defs/state"
        }
      },
      "additionalProperties": false
    },
    "defect": {
      "type": "object",
      "required": [
        "schema_version",
        "defect_id",
        "status",
        "blocking",
        "reproduction",
        "expected",
        "actual",
        "owner_role",
        "fix_task_id",
        "regression_evidence",
        "severity",
        "candidate",
        "evidence_refs",
        "project_id",
        "revision",
        "updated_at"
      ],
      "properties": {
        "defect_id": {
          "type": "string",
          "minLength": 1

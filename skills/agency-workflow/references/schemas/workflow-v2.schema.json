        "new_version",
        "affected_artifacts",
        "affected_tests",
        "gates_to_revalidate",
        "project_id",
        "revision",
        "updated_at"
      ],
      "properties": {
        "decision_id": {
          "type": "string",
          "minLength": 1
        },
        "requirement_id": {
          "type": "string",
          "minLength": 1
        },
        "previous": {
          "type": "object"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "affected_tasks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "authorization_ref": {
          "type": "string",
          "minLength": 1
        },
        "schema_version": {
          "const": 2
        },
        "new_version": {
          "type": "integer"
        },
        "affected_artifacts": {
          "type": "array",

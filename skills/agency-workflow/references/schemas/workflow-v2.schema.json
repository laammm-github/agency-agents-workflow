            "type": "string"
          }
        },
        "affected_tests": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "gates_to_revalidate": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "project_id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "updated_at": {
          "type": "string",
          "minLength": 1,
          "format": "date-time"
        }
      },
      "additionalProperties": false
    },
    "checkpoint": {
      "type": "object",
      "required": [
        "schema_version",
        "project_id",
        "workspace",
        "revision",
        "expected_hashes",
        "pending_operations",
        "authorization_ref",
        "milestone",
        "tasks",
        "artifacts",
        "last_confirmed_action",
        "next_preconditions",

        "status": {
          "type": "string",
          "minLength": 1,
          "enum": [
            "OPEN",
            "FIXING",
            "AWAITING_RETEST",
            "CLOSED",
            "REOPENED"
          ]
        },
        "blocking": {
          "type": "boolean"
        },
        "reproduction": {
          "type": "string",
          "minLength": 1
        },
        "expected": {
          "type": "string",
          "minLength": 1
        },
        "actual": {
          "type": "string",
          "minLength": 1
        },
        "owner_role": {
          "type": "string",
          "minLength": 1
        },
        "fix_task_id": {
          "type": "string",
          "minLength": 1
        },
        "regression_evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "schema_version": {
          "const": 2
        },
        "severity": {
          "type": "string",
          "minLength": 1
        },
        "candidate": {
          "type": "string",
          "minLength": 1
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "project_id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "updated_at": {
          "type": "string",
          "minLength": 1,
          "format": "date-time"
        }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": [
        "schema_version",
        "evidence_id",
        "tool",
        "kind",
        "exit_code",
        "candidate",
        "outcome",
        "artifact_ref",
        "timestamp",
        "task_id",
        "target_scope",
        "operation",
        "mutates",
        "summary",
        "project_id",
        "revision",
        "updated_at",
        "acceptance_ids",
        "supersedes",
        "requirement_versions",
        "input_hashes",
        "check",
        "provenance",
        "review_kind",
        "output_sha256"
      ],
      "properties": {
        "evidence_id": {
          "type": "string",
          "minLength": 1
        },
        "tool": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "exit_code": {
          "type": [
            "integer",
            "null"
          ]
        },
        "candidate": {
          "type": "string",
          "minLength": 1
        },
        "outcome": {
          "type": "string",
          "minLength": 1,
          "enum": [
            "PASS",
            "FAIL",
            "BLOCKED",
            "UNKNOWN"
          ]
        },
        "artifact_ref": {
          "type": "string",
          "minLength": 1
        },
        "timestamp": {
          "type": "string",
          "minLength": 1,
          "format": "date-time"
        },
        "schema_version": {
          "const": 2
        },
        "task_id": {
          "type": "string",
          "minLength": 1
        },
        "target_scope": {
          "type": "string",
          "minLength": 1
        },
        "operation": {
          "type": "string",
          "minLength": 1
        },
        "mutates": {
          "type": "boolean"
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "project_id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "updated_at": {
          "type": "string",
          "minLength": 1,
          "format": "date-time"
        },
        "acceptance_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "supersedes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "requirement_versions": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 1
          }
        },
        "input_hashes": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "check": {
          "enum": [
            "test",
            "review",
            "inspection",
            "integration",
            "browser",
            "security"
          ]
        },
        "provenance": {
          "enum": [
            "HOST_RETURN",
            "INDEPENDENT_READBACK",
            "MODEL_JUDGMENT"
          ]
        },
        "review_kind": {
          "enum": [
            "ROLE_PHASE",
            "INDEPENDENT_AGENT",
            "NOT_APPLICABLE"
          ]
        },
        "output_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "supporting_evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "command"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "exit_code": {
                "type": "integer"
              }
            }
          },
          "else": {
            "properties": {
              "exit_code": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "command"
              },
              "outcome": {
                "const": "PASS"
              }
            },
            "required": [
              "kind",
              "outcome"
            ]
          },
          "then": {
            "properties": {
              "exit_code": {
                "const": 0
              }
            }
          }
        }
      ]
    },
    "handoff": {
      "type": "object",
      "required": [
        "schema_version",
        "stage_id",
        "requirement_ids",
        "acceptance_ids",

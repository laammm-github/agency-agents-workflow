{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "task_id",
    "requirement_ids",
    "owner_role",
    "dependencies",
    "acceptance_ids",
    "artifact_refs",
    "evidence_refs",
    "status",
    "deliverables",
    "blocker_refs",
    "passed_acceptance_ids",
    "project_id",
    "revision",
    "updated_at"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "requirement_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "owner_role": {
      "type": "string",
      "minLength": 1
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "acceptance_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "artifact_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string",
      "minLength": 1,
      "enum": [
        "PLANNED",
        "PREFLIGHT",
        "EXECUTING",
        "VERIFYING",
        "COMPLETED",
        "BLOCKED",
        "FAILED",
        "UNKNOWN",
        "NEEDS_REVIEW"
      ]
    },
    "schema_version": {
      "const": 1
    },
    "deliverables": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "blocker_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "passed_acceptance_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer"
    },
    "updated_at": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}
